<mxCell id="v104" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1425" y="432" width="540" height="176" as="geometry"/></mxCell>
<mxCell id="v105" value="UI-03 · Ghi tri thức" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="442" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v106" value="Một textbox: “Nhập hoặc dán kinh nghiệm, ghi chú, nội dung cuộc&#xa;họp…”.&#xa;Hiện tác giả từ tài khoản, thời điểm sửa, trạng thái lưu.&#xa;Thông tin ngữ cảnh: loại máy/cụm máy, chủ đề (nếu đã biết).&#xa;Nút: “AI sắp xếp nội dung”, “Lưu và thoát”, “Mở nháp”.&#xa;Không có import file hoặc ghi âm trong MVP." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="481" width="510" height="116" as="geometry"/></mxCell>
<mxCell id="v107" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1425" y="1511" width="540" height="176" as="geometry"/></mxCell>
<mxCell id="v108" value="UI-04 · AI đang xử lý / bản gợi ý" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="1521" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v109" value="Hiện “Đang sắp xếp nội dung…”; vẫn giữ nội dung gốc.&#xa;Kết quả có liên kết về đoạn nguồn và ô chưa đủ dữ kiện.&#xa;Nếu có nhiều chủ đề: hiện danh sách đề xuất để chọn; mỗi đề xuất&#xa;có nháp riêng.&#xa;Nút: “Dùng bản gợi ý”, “Giữ bản đang sửa”, “Thử lại”, “Tự hoàn&#xa;thiện biểu mẫu”." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="1560" width="510" height="116" as="geometry"/></mxCell>
<mxCell id="v110" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1425" y="3108" width="540" height="336" as="geometry"/></mxCell>
<mxCell id="v111" value="UI-05 · Biểu mẫu tri thức" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="3118" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v112" value="Trường: tiêu đề; loại/model máy; dấu hiệu; điều kiện phát sinh;&#xa;model SẢN PHẨM riêng với model máy; chế độ/tốc độ/line/ca/môi&#xa;trường liên quan.&#xa;Điểm thay đổi 5M1E: Con người / Máy / Vật liệu-sản phẩm / Phương&#xa;pháp / Đo lường / Môi trường. Mỗi nhóm có Có thay đổi / Chưa ghi&#xa;nhận / Chưa kiểm tra.&#xa;Ghi giả thuyết, bằng chứng kiểm tra, lý do chọn/đổi hướng, thao&#xa;tác, kết quả, bài học, điều kiện áp dụng, giới hạn, an toàn và&#xa;đóng góp.&#xa;Phân biệt nguyên nhân đã xác nhận với giả thuyết/chưa xác định;&#xa;máy phục hồi chưa tự xác nhận nguyên nhân.&#xa;Chỉ mở trường theo nội dung liên quan; mục không áp dụng/chưa&#xa;biết có lý do, không bắt viết mọi mục 5M1E.&#xa;Nút: Đối chiếu kho tri thức, Quay lại nội dung gốc, Lưu và thoát." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="3157" width="510" height="276" as="geometry"/></mxCell>
<mxCell id="v113" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: k-start, k-input, k-structure, k-check, k-ready  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="3956" width="1935" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="SQ03" name="03 · Đối chiếu tri thức và xử lý nội dung trùng">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="3351">
