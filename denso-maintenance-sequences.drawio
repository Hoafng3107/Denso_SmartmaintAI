        <mxCell id="v97" parent="1" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" value="Người bảo trì: Ca của tôi; mở ca; lịch sử máy; tra cứu tri thức;&#xa;đề xuất của tôi.&#xa;Chuyên gia: Tri thức của tôi; ghi tri thức; ca cần hỗ trợ/đang&#xa;tham gia; tra cứu.&#xa;Chuyên gia trưởng: Hàng đợi duyệt; việc đang xem; lịch sử quyết&#xa;định; tra cứu.&#xa;Hiện tên nhân viên, vai trò đang dùng, thông báo chưa đọc.&#xa;Nếu có nhiều quyền đã cấp: cho đổi không gian làm việc; không tạo&#xa;tài khoản mới." vertex="1">
          <mxGeometry height="176" width="510" x="1155" y="2451" as="geometry" />
        </mxCell>
