<mxCell id="v142" value="SQ11.41 Hiện người phụ trách,&#xa;việc còn lại và lý do chờ" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="132" y="5240" width="261" height="38" as="geometry"/></mxCell>
<mxCell id="v143" value="ref SQ08 · Mở cùng caseId; xem các đợt cũ và bàn giao, tạo đợt mới chỉ khi làm tiếp" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ08"><mxGeometry x="45" y="5437" width="1610" height="66" as="geometry"/></mxCell>
<mxCell id="v144" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1710" y="432" width="540" height="256" as="geometry"/></mxCell>
<mxCell id="v145" value="UI-22 · Công việc trong đợt" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="442" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v146" value="Đầu màn hình: mã hồ sơ, đợt hiện tại, máy, chủ hồ sơ, chuyên gia&#xa;đang tham gia.&#xa;Hiện phương án, nguồn, người dự kiến làm và điều kiện an toàn từ&#xa;quy trình có hiệu lực.&#xa;PM: checklist điền sẵn; mỗi mục có giá trị/đơn vị, đạt/không&#xa;đạt/chưa làm và bất thường.&#xa;Nút: Ghi nhận nhanh, Tra cứu lại, Yêu cầu chuyên gia, Xem nháp&#xa;báo cáo, Kết thúc đợt.&#xa;Ghi theo mốc, không yêu cầu nhập từng động tác; không coi hạng&#xa;mục trong kế hoạch là đã thực hiện." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="481" width="510" height="196" as="geometry"/></mxCell>
<mxCell id="v147" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1710" y="2447" width="540" height="256" as="geometry"/></mxCell>
<mxCell id="v148" value="UI-23 · Kết quả khác với tiến độ" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="2457" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v149" value="Kết quả máy: đã phục hồi/chưa phục hồi/chưa đủ kiểm chứng; căn cứ&#xa;theo kiểm tra thực tế.&#xa;Tiến độ: đang làm/chờ linh kiện/chờ hỗ trợ/bàn giao/kết thúc công&#xa;việc.&#xa;Kết thúc khi chưa khắc phục: phải có quyết định đúng thẩm quyền,&#xa;lý do và nơi tiếp nhận nếu có.&#xa;Không có quyết định phù hợp thì giữ mở, không đánh dấu thành&#xa;công.&#xa;Nút: Tiếp tục điều tra, Gọi chuyên gia, Tóm tắt và bàn giao, Lập&#xa;báo cáo tổng kết." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="2496" width="510" height="196" as="geometry"/></mxCell>
<mxCell id="v150" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1710" y="3918" width="540" height="196" as="geometry"/></mxCell>
<mxCell id="v151" value="UI-37 · Tóm tắt đợt và bàn giao" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="3928" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v152" value="AI điền: đã quan sát/kiểm tra/làm gì, ai làm, kết quả, giả thuyết&#xa;còn mở, việc cần làm tiếp.&#xa;Người bảo trì kiểm tra; chuyên gia xác nhận phần liên quan khi có&#xa;thể.&#xa;Tóm tắt gắn roundId, không phải báo cáo cuối độc lập.&#xa;Bàn giao nhập người/đơn vị nhận theo quyền, lý do dừng và lưu ý.&#xa;Thông báo: Đã lưu đợt và bàn giao. Hồ sơ vẫn chờ xử lý." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="3967" width="510" height="136" as="geometry"/></mxCell>
<mxCell id="v153" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-work-round, r-round-result, r-round-summary, r-handover-check, r-next, r-open-save, r-wait, w-start, w-open-round, r-action-merge, r-plan, r-act, w-more, r-verify, w-outcome, w-result, w-end, w-stop, w-exception, w-exception-approved, w-pm-abnormal  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="5656" width="2220" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
