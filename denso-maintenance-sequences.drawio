        </mxCell>
        <mxCell id="v67" value="ref SQ04 · Gửi revision mới, giữ proposalId và số vòng bổ sung" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ04">
          <mxGeometry x="45" y="2496" width="1325" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v68" value="Nếu phát hiện dữ kiện thực tế của báo cáo sai: tạo bản đính chính có lý do và người xác nhận theo SQ12; không âm thầm ghi nội dung đề xuất ngược vào báo cáo." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1">
          <mxGeometry x="45" y="2654" width="1325" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v69" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="432" width="540" height="176" as="geometry" />
        </mxCell>
        <mxCell id="v70" value="UI-12 · Chi tiết yêu cầu bổ sung" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v71" value="Hiện người nhận xét, ngày giờ, lần xét duyệt, từng mục cần sửa và&#xa;lý do.&#xa;Bên cạnh có bản đã gửi, bản đang sửa và phần người duyệt đề nghị&#xa;thay đổi.&#xa;Nút “Sửa đề xuất”, “Xem nguồn”, “Lưu và thoát”.&#xa;Báo cáo ca gốc vẫn chỉ đọc; không thay đổi theo nội dung đề xuất." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="481" width="510" height="116" as="geometry" />
        </mxCell>
        <mxCell id="v72" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="1703" width="540" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v73" value="UI-13 · Gửi lại sau bổ sung" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1713" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v74" value="Hiện danh sách nhận xét đã xử lý/chưa xử lý và so sánh với lần&#xa;gửi trước.&#xa;Nút “Đối chiếu lại”, sau đó “Gửi lại kiểm duyệt”.&#xa;Thông báo khi thiếu: “Còn mục cần bổ sung hoặc chưa có giải&#xa;thích”.&#xa;Tác giả phải xác nhận nội dung chuyên môn do người duyệt đề nghị;&#xa;không tự xuất bản sau khi nhận sửa." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1752" width="510" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v75" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: k-return, k-revise, r-revise  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="2819" width="1935" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
