<mxCell id="v170" value="ref SQ13 · Đối chiếu bài học của toàn bộ hồ sơ; kết quả chưa khắc phục cũng được giữ đúng phạm vi bằng chứng" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ13"><mxGeometry x="45" y="6074" width="2180" height="66" as="geometry"/></mxCell>
<mxCell id="v171" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="2280" y="432" width="540" height="256" as="geometry"/></mxCell>
<mxCell id="v172" value="UI-24 · Báo cáo tổng kết do AI soạn" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2295" y="442" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v173" value="Nút Xem nháp / Cập nhật từ nhật ký; dùng cùng reportId, tăng&#xa;revision khi cập nhật.&#xa;Nội dung: máy/công việc, điều kiện và 5M1E, các đợt, giả thuyết,&#xa;căn cứ, bước đã thử, kết quả, người tham gia, nguyên nhân xác&#xa;nhận/chưa xác định, việc còn lại.&#xa;Hiển thị cả lần thử chưa hiệu quả; từng nhận định có liên kết về&#xa;ghi nhận gốc.&#xa;Phân biệt việc đã làm với đề xuất trung/dài hạn.&#xa;AI không ghi đè phần người dùng đã sửa; cho xem thay đổi trước&#xa;khi áp dụng." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2295" y="481" width="510" height="196" as="geometry"/></mxCell>
<mxCell id="v174" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="2280" y="2261" width="540" height="256" as="geometry"/></mxCell>
<mxCell id="v175" value="UI-25 · Xác nhận chuyên gia" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2295" y="2271" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v176" value="Hiện phần đóng góp của từng người, bản đã xác nhận và phần bị đổi&#xa;ý nghĩa.&#xa;Phần đã được xác nhận cuối đợt và không đổi: giữ xác nhận, không&#xa;bắt xác nhận lại.&#xa;Phần mới/đổi ý nghĩa: gửi nhóm nội dung cần xác nhận cho đúng&#xa;chuyên gia.&#xa;Chuyên gia chọn Xác nhận đúng / Yêu cầu sửa. Người bảo trì không&#xa;xác nhận thay.&#xa;Nếu chuyên gia chưa phản hồi: Lưu chờ và thoát; trạng thái máy và&#xa;kết thúc công việc không bị đảo ngược." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2295" y="2310" width="510" height="196" as="geometry"/></mxCell>
<mxCell id="v177" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="2280" y="4506" width="540" height="256" as="geometry"/></mxCell>
<mxCell id="v178" value="UI-38 · Ba trạng thái riêng" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2295" y="4516" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v179" value="Tình trạng máy: đã phục hồi/chưa phục hồi/chưa đủ kiểm chứng — từ&#xa;dữ kiện thực tế.&#xa;Tiến độ công việc: đang làm/chờ/bàn giao/kết thúc, kèm kết quả và&#xa;lý do.&#xa;Báo cáo: Nháp/Chờ xác nhận/Đã xác nhận; máy phục hồi vẫn có thể&#xa;chờ xác nhận báo cáo.&#xa;HozenDX: chưa đồng bộ/đang đồng bộ/đã đồng bộ lúc…/đồng bộ lỗi.&#xa;Chỉ hiện thành công khi có xác nhận bên nhận.&#xa;Sau chốt: đính chính có lý do và phiên bản, không sửa ngầm lịch&#xa;sử." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2295" y="4555" width="510" height="196" as="geometry"/></mxCell>
