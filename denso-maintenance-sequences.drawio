        </mxCell>
        <mxCell id="v62" value="Đọc nguồn là thao tác hỗ trợ, không phê duyệt thêm lần nữa. Phản hồi được giữ trong ca và chỉ trở thành tri thức xuất bản khi đi qua SQ13 → SQ04 → SQ05." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1">
          <mxGeometry x="45" y="2402" width="1325" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v63" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="432" width="540" height="276" as="geometry" />
        </mxCell>
        <mxCell id="v64" value="UI-28 · Chi tiết tri thức / case đã duyệt" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v65" value="Hiện tên, loại nội dung, máy/phạm vi, tác giả/người đóng góp,&#xa;người duyệt, ngày và phiên bản.&#xa;Nội dung: triệu chứng/bối cảnh, nguyên nhân và bằng chứng, kiểm&#xa;tra, hướng xử lý, kết quả, điều kiện, giới hạn, an toàn và bài&#xa;học.&#xa;Có liên kết nguồn/báo cáo theo quyền; dữ liệu nhạy cảm không được&#xa;mở chỉ vì biết ID.&#xa;Nguồn đang được xem giữ đúng phiên bản đã trích dẫn; nếu có bản&#xa;mới thì gắn nhãn và cho đối chiếu.&#xa;Nút “Quay lại kết quả”, “Xem phiên bản hiện hành”, “Ghi nhận tham&#xa;khảo” khi đang có ca." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="481" width="510" height="216" as="geometry" />
        </mxCell>
        <mxCell id="v66" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="1570" width="540" height="216" as="geometry" />
        </mxCell>
        <mxCell id="v67" value="UI-29 · Tham khảo / áp dụng trong ca" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1580" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v68" value="Phân biệt: “Đã đọc” / “Chọn làm hướng tham khảo” / “Đã thực hiện”&#xa;/ “Kết quả sau áp dụng”.&#xa;Phản hồi: phù hợp, áp dụng một phần, không áp dụng được; ghi điểm&#xa;khác và lý do.&#xa;Chọn nguồn không tự đánh dấu sửa xong; kết quả thực tế lấy từ&#xa;nhật ký/báo cáo.&#xa;Ngoài ca đang làm: chỉ tra cứu; không tạo case sửa chữa giả chỉ&#xa;để lưu một lần đọc." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1619" width="510" height="156" as="geometry" />
        </mxCell>
        <mxCell id="v69" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: k-read, r-assess  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="2567" width="1935" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
