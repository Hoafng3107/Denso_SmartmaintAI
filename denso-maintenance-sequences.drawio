        <mxCell id="v63" value="SQ04.19 Hiện thông tin theo dõi&#xa;và liên kết tới đề xuất" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1">
