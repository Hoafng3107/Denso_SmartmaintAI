<mxCell id="v102" value="SQ16.32 Hiện phần cần xem lại;&#xa;giữ nguyên lịch sử đã ghi" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="417" y="3545" width="261" height="38" as="geometry"/></mxCell>
<mxCell id="v103" value="ref SQ12 · Chỉ chạy phần soạn/xem nháp; quay lại cùng đợt, chưa chốt báo cáo" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ12"><mxGeometry x="45" y="3742" width="1895" height="66" as="geometry"/></mxCell>
<mxCell id="v104" value="Nhật ký thất bại mô tả đúng điều đã quan sát: sau bước X hiện tượng vẫn còn. Không tự kết luận X vô dụng trong mọi bối cảnh hoặc nguyên nhân Y đã bị loại trừ." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1"><mxGeometry x="45" y="3864" width="1895" height="48" as="geometry"/></mxCell>
<mxCell id="v105" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1995" y="432" width="540" height="256" as="geometry"/></mxCell>
<mxCell id="v106" value="UI-35 · Vùng Ghi nhận nhanh trong hồ sơ" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2010" y="442" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v107" value="Loại: Quan sát / Kiểm tra / Nhận định / Thao tác / Kết quả.&#xa;Ô nội dung vài dòng; gõ hoặc dán. Không có ghi âm trong MVP.&#xa;Người nhập tự lấy từ tài khoản; người thực hiện/chuyên gia hướng&#xa;dẫn hiển thị riêng, có thể chọn đúng người.&#xa;Kết quả: chưa có/có kết quả; số đo kèm đơn vị khi liên quan.&#xa;Lý do lựa chọn mở khi ghi quyết định quan trọng; AI chỉ nhắc nếu&#xa;còn thiếu căn cứ.&#xa;Thời điểm nhập tự ghi; cho bổ sung thời điểm thực tế khi ghi bù.&#xa;Nút Lưu ghi nhận; nháp tự giữ, chỉ báo Đã lưu khi máy chủ xác&#xa;nhận." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2010" y="481" width="510" height="196" as="geometry"/></mxCell>
<mxCell id="v108" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1995" y="2456" width="540" height="236" as="geometry"/></mxCell>
<mxCell id="v109" value="UI-36 · Đóng góp theo người / theo đợt" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2010" y="2466" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v110" value="Nhóm theo chuyên gia và đợt; hiện ai nhập, ai thực hiện, nội&#xa;dung, thời điểm, trạng thái xác nhận.&#xa;Người bảo trì có thể gửi xác nhận cuối đợt; không gửi cho từng&#xa;dòng bắt buộc.&#xa;Chuyên gia xác nhận đúng hoặc chỉ ra phần cần sửa.&#xa;Nội dung sửa làm đổi ý nghĩa: xác nhận lại phần liên quan. Không&#xa;đặt lại phần không đổi.&#xa;Nhật ký đã lưu dù chưa xác nhận; báo cáo/tái sử dụng phải kiểm&#xa;tra trạng thái này." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2010" y="2505" width="510" height="176" as="geometry"/></mxCell>
<mxCell id="v111" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: w-note, w-save-event, w-confirm-now, w-expert-check  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="4029" width="2505" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
