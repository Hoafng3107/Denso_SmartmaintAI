<mxCell id="v73" value="SQ10.25 Trao đổi nhận định, căn cứ và phân công hỗ trợ tại hiện trường" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="132" y="2703" width="1686" height="19" as="geometry"/></mxCell>
<mxCell id="v74" value="Trao đổi trực tiếp giữa hai người; người bảo trì chủ động ghi vào web. MVP không có ghi âm hoặc chép lời tự động." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1"><mxGeometry x="45" y="2771" width="1895" height="48" as="geometry"/></mxCell>
<mxCell id="v75" value="ref SQ16 · Người bảo trì ghi nhanh, chuyên gia có thể bổ sung; xác nhận theo nhóm đóng góp" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ16"><mxGeometry x="45" y="2839" width="1895" height="66" as="geometry"/></mxCell>
<mxCell id="v76" value="ref SQ11 · Chốt phương án, kiểm tra kết quả; người bảo trì tiếp tục hỗ trợ và quản lý hồ sơ" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ11"><mxGeometry x="45" y="2961" width="1895" height="66" as="geometry"/></mxCell>
<mxCell id="v77" value="Không yêu cầu chuyên gia vừa thao tác vừa nhập từng bước. Người bảo trì có thể ghi bù theo mốc khi đang phải hỗ trợ; giữ performedAt khác recordedAt và nhãn chờ xác nhận khi cần." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1"><mxGeometry x="45" y="3083" width="1895" height="48" as="geometry"/></mxCell>
<mxCell id="v78" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1995" y="432" width="540" height="176" as="geometry"/></mxCell>
<mxCell id="v79" value="UI-20 · Gọi chuyên gia" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2010" y="442" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v80" value="Lý do, câu hỏi cần làm rõ, vị trí máy, bối cảnh, các lần thử và&#xa;kết quả chưa hiệu quả.&#xa;AI soạn bàn giao từ nhật ký; người bảo trì đọc/sửa trước khi gửi.&#xa;Có yêu cầu đang chờ thì mở/cập nhật yêu cầu đó, không tạo trùng.&#xa;Chờ chuyên gia vẫn cho ghi thêm nhật ký và lưu bàn giao; không&#xa;coi đã có người nhận." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2010" y="481" width="510" height="116" as="geometry"/></mxCell>
<mxCell id="v81" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1995" y="1701" width="540" height="216" as="geometry"/></mxCell>
<mxCell id="v82" value="UI-21 · Đang phối hợp với chuyên gia" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2010" y="1711" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v83" value="Hiện người phụ trách, chuyên gia, thời điểm nhận và thời điểm&#xa;thực sự tham gia, công đoạn hiện tại.&#xa;Chuyên gia: Nhận hỗ trợ / Chưa thể hỗ trợ kèm lý do.&#xa;Người bảo trì: hỗ trợ theo phân công và mở vùng Ghi nhận nhanh&#xa;ngay trong hồ sơ.&#xa;Người thực hiện và người nhập là hai trường riêng. Không tự mặc&#xa;định mọi việc đều do chuyên gia làm.&#xa;Chuyên gia có thể nhập trực tiếp hoặc xác nhận nhóm ghi nhận sau." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2010" y="1750" width="510" height="156" as="geometry"/></mxCell>
<mxCell id="v84" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-call, r-handover, w-expert-available, r-join, r-investigate  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="3248" width="2505" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="SQ11" name="11 · Đợt xử lý, PM, tóm tắt bàn giao và tiếp tục hồ sơ"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="5699"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="v1" value="SQ11 · Đợt xử lý, PM, tóm tắt bàn giao và tiếp tục hồ sơ" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="18" width="2220" height="48" as="geometry"/></mxCell>
<mxCell id="v2" value="Đầu vào: Có hồ sơ BM/PM đã xác minh; có thể bắt đầu đợt mới hoặc tiếp tục đợt đang làm." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="70" width="2220" height="44" as="geometry"/></mxCell>
<mxCell id="v3" value="Kết quả: Kết quả thực tế và tóm tắt đợt được lưu; đi điều tra tiếp, chờ/bàn giao hoặc lập báo cáo tổng kết." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="121" width="2220" height="44" as="geometry"/></mxCell>
<mxCell id="v4" value="Thời gian: trên → dưới  |  Liền: yêu cầu/thao tác  |  Đứt: trả kết quả  |  alt: chọn nhánh  ·  opt: tùy điều kiện  ·  loop: lặp  ·  break: dừng  ·  ref: xem trang liên quan" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="171" width="2220" height="26" as="geometry"/></mxCell>
