<mxCell id="v85" value="SQ13.30 Danh sách mục còn thiếu&#xa;hoặc đủ điều kiện gửi" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="417" y="3025" width="261" height="38" as="geometry"/></mxCell>
<mxCell id="v86" value="Nếu nội dung đề xuất thay đổi đáng kể so với bản đã đối chiếu, chạy lại khối 1. Cập nhật giữ proposalId; không tạo thêm một đề xuất cho mỗi lần sửa." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1"><mxGeometry x="45" y="3129" width="1610" height="48" as="geometry"/></mxCell>
<mxCell id="v87" value="ref SQ04 · Người bảo trì xác nhận và gửi; các loại Liên kết/Cập nhật/Mới đều qua người duyệt" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ04"><mxGeometry x="45" y="3197" width="1610" height="66" as="geometry"/></mxCell>
<mxCell id="v88" value="Nếu AI đối chiếu lỗi: hiện “Lịch sử ca đã được lưu; chưa đối chiếu được tri thức”. Có thể lưu đề xuất đang soạn và thử lại sau; chưa coi đề xuất đã đủ bước gửi." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1"><mxGeometry x="45" y="3319" width="1610" height="48" as="geometry"/></mxCell>
<mxCell id="v89" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1710" y="432" width="540" height="276" as="geometry"/></mxCell>
<mxCell id="v90" value="UI-26 · Giá trị tái sử dụng của hồ sơ" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="442" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v91" value="Hiện Báo cáo đã xác nhận và lưu vào lịch sử máy.&#xa;Bên trái là dữ kiện của tất cả đợt, gồm các lần chưa hiệu quả;&#xa;bên phải là nguồn tương tự và gợi ý AI.&#xa;So hiện tượng, điều kiện/model sản phẩm/5M1E, kiểm tra, căn cứ,&#xa;nguyên nhân, bước xử lý, kết quả, điều kiện áp dụng và an toàn.&#xa;Bài học từ lần chưa hiệu quả giữ đúng phạm vi bằng chứng; không&#xa;kết luận phương pháp luôn vô dụng hoặc nguyên nhân chắc chắn bị&#xa;loại trừ.&#xa;Phân biệt đã chứng minh và còn giả thuyết. Kết thúc chưa khắc&#xa;phục không được ghi thành sửa thành công.&#xa;Lỗi AI không làm mất lịch sử hoặc đổi kết quả thực tế." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="481" width="510" height="216" as="geometry"/></mxCell>
<mxCell id="v92" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1710" y="1177" width="540" height="216" as="geometry"/></mxCell>
<mxCell id="v93" value="UI-27 · Chọn đề xuất từ ca" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="1187" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v94" value="Lựa chọn “Chỉ lưu lịch sử” / “Liên kết case đã có” / “Bổ sung tri&#xa;thức đã có” / “Tạo case tri thức mới”.&#xa;Liên kết: chọn nguồn/phiên bản và lý do phù hợp.&#xa;Cập nhật: ghi phần khác và phạm vi bổ sung.&#xa;Case mới: tiêu đề, bối cảnh, nguyên nhân, kiểm tra/xử lý, kết&#xa;quả, bài học, điều kiện và an toàn.&#xa;Tác giả/người đóng góp lấy từ ca, có thể bổ sung đúng thực tế;&#xa;người gửi không mặc nhiên là người làm mọi thao tác." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="1226" width="510" height="156" as="geometry"/></mxCell>
<mxCell id="v95" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-diff, r-proposal, r-useful, r-only-history, r-history-end  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="3484" width="2220" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
