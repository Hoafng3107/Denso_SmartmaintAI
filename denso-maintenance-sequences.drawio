<mxCell id="v2" value="Đầu vào: Người bảo trì mở sự cố, công việc PM, quét mã máy hoặc tiếp tục một hồ sơ được phép xem." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="70" width="1935" height="44" as="geometry"/></mxCell>
<mxCell id="v3" value="Kết quả: Có hồ sơ đúng máy, bối cảnh được xác nhận và nguồn dữ liệu; hồ sơ chỉ chờ báo cáo mở thẳng bước xác nhận." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="121" width="1935" height="44" as="geometry"/></mxCell>
