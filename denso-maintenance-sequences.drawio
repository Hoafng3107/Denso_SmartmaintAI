<mxCell id="v2" value="Đầu vào: Hồ sơ có nhật ký; người dùng muốn xem nháp hoặc công việc đủ điều kiện kết thúc để chốt báo cáo." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="70" width="2790" height="44" as="geometry"/></mxCell>
<mxCell id="v3" value="Kết quả: Cùng reportId có revision mới, hoặc báo cáo đã xác nhận để trích xuất tri thức; chờ xác nhận không làm mất dữ kiện." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="121" width="2790" height="44" as="geometry"/></mxCell>
