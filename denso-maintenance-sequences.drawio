<mxCell id="v1" value="SQ09 · RAG tra cứu và hỗ trợ chọn hướng xử lý" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="18" width="2220" height="48" as="geometry"/></mxCell>
<mxCell id="v2" value="Đầu vào: Ca đang mở, đã lưu kiểm tra sơ bộ và có đủ thông tin tối thiểu để tra cứu." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="70" width="2220" height="44" as="geometry"/></mxCell>
<mxCell id="v3" value="Kết quả: Người bảo trì chọn bổ sung kiểm tra, xin chuyên gia hoặc chuyển sang chốt phương án trong thẩm quyền." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="121" width="2220" height="44" as="geometry"/></mxCell>
<mxCell id="v4" value="Thời gian: trên → dưới  |  Liền: yêu cầu/thao tác  |  Đứt: trả kết quả  |  alt: chọn nhánh  ·  opt: tùy điều kiện  ·  loop: lặp  ·  break: dừng  ·  ref: xem trang liên quan" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="171" width="2220" height="26" as="geometry"/></mxCell>
<mxCell id="v5" value="ĐẶC TẢ GIAO DIỆN&#xa;Thông tin hiển thị · nút bấm · thông báo" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1710" y="222" width="540" height="66" as="geometry"/></mxCell>
