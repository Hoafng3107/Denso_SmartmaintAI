<mxCell id="v88" value="ref SQ11 · Xác nhận điều kiện, an toàn rồi thực hiện và kiểm tra kết quả" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ11"><mxGeometry x="45" y="3351" width="1610" height="66" as="geometry"/></mxCell>
<mxCell id="v89" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1710" y="432" width="540" height="316" as="geometry"/></mxCell>
<mxCell id="v90" value="UI-18 · Kết quả tra cứu cho hồ sơ" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="442" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v91" value="Đầu trang giữ máy, đợt, dấu hiệu và bối cảnh; hiển thị thời điểm&#xa;và lần tra cứu.&#xa;Đối chiếu 3 nhóm theo Q&amp;A: hiện tượng; điều kiện phát sinh; kết&#xa;quả kiểm tra hiện trường. Thêm điểm thay đổi 5M1E.&#xa;Phân biệt model máy với model sản phẩm; tốc độ/chế độ/line/ca/môi&#xa;trường chỉ dùng khi có dữ kiện.&#xa;Các case và tri thức chuyên gia đã duyệt ở trên, ưu tiên 1–3 và&#xa;có Xem thêm. Mỗi nguồn có phiên bản, giống/khác, điều kiện, giới&#xa;hạn và kết quả trước.&#xa;Hồ sơ thô từ HozenDX được ghi nhãn nguồn tham chiếu; chưa tự coi&#xa;là know-how đã duyệt.&#xa;Không gọi số tiêu chí trùng là xác suất thành công; thiếu dữ liệu&#xa;không đồng nghĩa giống nhau." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="481" width="510" height="256" as="geometry"/></mxCell>
<mxCell id="v92" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1710" y="2214" width="540" height="236" as="geometry"/></mxCell>
<mxCell id="v93" value="UI-19 · Phân tích hỗ trợ quyết định" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="2224" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v94" value="Tóm tắt: đã biết gì, còn thiếu gì, giả thuyết và bằng chứng, các&#xa;bước đã thử.&#xa;Nhóm: xử lý trước mắt / theo dõi-sửa trung hạn / cải tiến-thay&#xa;thế dài hạn; chỉ hiện đề xuất có căn cứ.&#xa;An toàn: trích quy trình phù hợp máy và thao tác; thiếu quy trình&#xa;thì nói rõ cần xác minh.&#xa;Nút “Mở nguồn”, “Bổ sung kiểm tra”, “Chọn phương án”, “Yêu cầu&#xa;chuyên gia”.&#xa;“Chọn phương án” không mang nghĩa AI cho phép vận hành máy." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1725" y="2263" width="510" height="176" as="geometry"/></mxCell>
<mxCell id="v95" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-retrieve, r-insight, r-assess, r-route, r-measure  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="3570" width="2220" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
