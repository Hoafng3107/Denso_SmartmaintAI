<mxCell id="v129" value="SQ08.36 Đã lưu; mở hành động phù&#xa;hợp BM/PM" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="417" y="4442" width="261" height="38" as="geometry"/></mxCell>
<mxCell id="v130" value="ref SQ09 · Tra cứu bằng hiện tượng, điều kiện, kiểm tra và điểm thay đổi" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ09"><mxGeometry x="45" y="4567" width="1325" height="66" as="geometry"/></mxCell>
<mxCell id="v131" value="ref SQ11 · Bắt đầu đợt thực hiện checklist; chỉ nhập kết quả thực tế" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ11"><mxGeometry x="45" y="4724" width="1325" height="66" as="geometry"/></mxCell>
<mxCell id="v132" value="ref SQ11 · Chọn điều tra tiếp hoặc tóm tắt/bàn giao, giữ hồ sơ mở" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ11"><mxGeometry x="45" y="4881" width="1325" height="66" as="geometry"/></mxCell>
<mxCell id="v133" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1425" y="432" width="540" height="236" as="geometry"/></mxCell>
<mxCell id="v134" value="UI-16 · Bắt đầu công việc" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="442" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v135" value="Hai lối vào: Sự cố BM / Bảo trì định kỳ PM; có Mở hồ sơ đang chờ.&#xa;Chọn công việc có sẵn hoặc quét/nhập mã máy. Camera không dùng&#xa;được thì nhập mã.&#xa;Hiện máy, maker/model máy, năm, thông số, line/khu vực và chủ hồ&#xa;sơ.&#xa;Gắn nhãn HozenDX / dữ liệu mô phỏng / dữ liệu lưu trước; hiện&#xa;thời điểm lấy.&#xa;Không tự coi thông tin hệ thống là tình trạng hiện trường mới&#xa;nhất." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="481" width="510" height="176" as="geometry"/></mxCell>
<mxCell id="v136" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1425" y="4221" width="540" height="256" as="geometry"/></mxCell>
<mxCell id="v137" value="UI-17 · Bối cảnh và 5M1E" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="4231" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v138" value="Dấu hiệu: Alarm, hiện tượng, bộ phận, thời điểm/tần suất. Không&#xa;ép nhập nguyên nhân.&#xa;Điều kiện: chế độ vận hành, MODEL SẢN PHẨM (khác model máy), tốc&#xa;độ, line, ca, môi trường liên quan.&#xa;5M1E: Con người / Máy / Vật liệu-sản phẩm / Phương pháp / Đo&#xa;lường / Môi trường.&#xa;Mỗi nhóm: Có thay đổi / Chưa ghi nhận / Chưa kiểm tra; chỉ mở ô&#xa;chi tiết khi cần.&#xa;Hiện hồ sơ thay đổi từ HozenDX để đối chiếu; chỉ nhập phần thiếu&#xa;hoặc khác thực tế." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="4270" width="510" height="196" as="geometry"/></mxCell>
<mxCell id="v139" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="1425" y="4495" width="540" height="196" as="geometry"/></mxCell>
<mxCell id="v140" value="UI-39 · Dữ liệu nguồn và dữ kiện thực tế" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="4505" width="510" height="32" as="geometry"/></mxCell>
<mxCell id="v141" value="Panel tham chiếu: lịch sử BM, biện pháp cũ, kết quả PM, SOP/DAS,&#xa;bản vẽ, cải tạo, linh kiện/tồn kho nếu được cung cấp.&#xa;Nguồn hệ thống và quan sát hiện trường có nhãn, thời điểm riêng.&#xa;Nếu khác nhau: hiện cả hai để xác minh; không tự ghi đè lịch sử&#xa;hoặc dữ liệu HozenDX.&#xa;Hồ sơ BM thô là dữ liệu tham chiếu; chưa tự trở thành tri thức đã&#xa;duyệt cho AI hướng dẫn." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440" y="4544" width="510" height="136" as="geometry"/></mxCell>
<mxCell id="v142" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-start, r-open, r-entry-state, r-inspect, r-abnormal, e-start, e-select, e-fetch, e-hozen, e-source, e-fallback, e-fallback-valid, e-confirm, e-existing, e-resume, e-type, e-pm-plan, e-pm-import, e-pm-template, e-bm, e-check-context, e-persist, e-end, e-unavailable  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="5100" width="1935" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="SQ09" name="09 · RAG tra cứu và hỗ trợ chọn hướng xử lý"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="3613"><root><mxCell id="0"/>
