        <mxCell id="reviewer-label" parent="reviewer" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;align=center;fontSize=18;fontStyle=1;fontColor=#a67426;" value="CHUYÊN GIA&#xa;TRƯỞNG" vertex="1">
          <mxGeometry height="100" width="160" x="10" y="20" as="geometry" />
        </mxCell>
        <mxCell id="reviewer-hint" parent="reviewer" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;align=center;fontSize=13;fontColor=#64748b;" value="Duyệt tri thức&#xa;đúng phạm vi" vertex="1">
          <mxGeometry height="110" width="150" x="15" y="130" as="geometry" />
        </mxCell>
        <mxCell id="note-0" parent="reviewer" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="Chuyên gia tham gia theo yêu cầu, nêu căn cứ điều tra, hướng dẫn hoặc trực tiếp xử lý; người bảo trì hỗ trợ và ghi nhanh theo mốc.&#xa;Ghi riêng người thực hiện và người ghi; chuyên gia có thể bổ sung trực tiếp, rồi xác nhận theo nhóm đóng góp của mình.&#xa;Nhật ký giữ cả bước chưa hiệu quả; AI không suy ra “nguyên nhân đã bị loại trừ” khi chưa có bằng chứng.&#xa;Trang 04 mô tả phối hợp và ghi nhận; trang 05 mô tả AI tổng kết và xác nhận, không bắt viết lại cuối ca." vertex="1">
          <mxGeometry height="145" width="1850" x="300" y="30" as="geometry" />
        </mxCell>
        <mxCell id="note-1" parent="reviewer" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="Ba trạng thái riêng: tình trạng máy / tiến độ công việc / xác nhận báo cáo. Máy phục hồi không tự chứng minh nguyên nhân gốc hoặc hoàn tất hồ sơ.&#xa;Kết thúc công việc: đạt tiêu chí sau xử lý HOẶC có quyết định được phép kết thúc với kết quả chưa khắc phục/chuyển đơn vị/thay thiết bị; phải ghi lý do.&#xa;Chờ linh kiện/chờ hỗ trợ/bàn giao thông thường vẫn giữ hồ sơ mở. Khi tiếp tục: cùng caseId, tạo đợt tiếp theo có roundId riêng.&#xa;HozenDX cung cấp dữ liệu có sẵn; lịch PM/API/tình trạng tức thời chỉ dùng khi tích hợp thực sự cung cấp, không tự giả định." vertex="1">
          <mxGeometry height="145" width="3850" x="300" y="230" as="geometry" />
        </mxCell>
        <mxCell id="r-review" parent="reviewer" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#172b43;rounded=1;arcSize=12;fillColor=#fff5e6;strokeColor=#a67426;strokeWidth=1.6;spacing=10;" value="Người duyệt độc lập&#xa;Đánh giá bằng chứng,&#xa;phạm vi, an toàn, trùng" vertex="1">
          <mxGeometry height="92" width="210" x="4430" y="80" as="geometry" />
        </mxCell>
