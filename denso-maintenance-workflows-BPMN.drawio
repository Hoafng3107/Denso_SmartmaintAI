        <mxCell id="hozen-hint" parent="hozen" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;align=center;fontSize=13;fontColor=#64748b;" value="Dữ liệu có quyền&#xa;truy cập; API và lịch&#xa;PM tùy khả năng" vertex="1">
          <mxGeometry height="110" width="150" x="15" y="130" as="geometry" />
        </mxCell>
        <mxCell id="note-0" parent="hozen" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="Q&amp;A xác nhận HozenDX/AIHO có lý lịch máy (maker/model/năm/thông số), cấu trúc/linh kiện, chế độ bảo dưỡng, BM, nội dung sửa chữa, kết quả PM, SOP/DAS, bản vẽ, hồ sơ cải tạo và tồn kho.&#xa;Q&amp;A chưa xác nhận API, lịch/phân công PM hay trạng thái máy tức thời. Prototype mô phỏng có ghi nguồn; chỉ điền phần tích hợp thực sự cung cấp.&#xa;Không tìm thấy máy / không có quyền / chưa xác minh dữ liệu: chưa cho bắt đầu. Bản lưu cũ được gắn thời điểm và người dùng xác nhận, không giả vờ đồng bộ thành công.&#xa;Nếu có hồ sơ đang mở: ưu tiên tiếp tục/tham gia; công việc khác phải có lý do, không gộp sự cố độc lập. PM phát hiện bất thường giữ liên kết hạng mục và hồ sơ gốc.&#xa;Dữ liệu tích hợp và dữ kiện hiện trường có nguồn riêng; khác nhau được hiển thị để xác minh, không âm thầm ghi đè." vertex="1">
          <mxGeometry height="155" width="3070" x="1530" y="65" as="geometry" />
        </mxCell>
        <mxCell id="e-hozen" parent="hozen" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#172b43;rounded=1;arcSize=12;fillColor=#eaf2f4;strokeColor=#467580;strokeWidth=1.6;spacing=10;" value="Trả dữ liệu được cấp&#xa;Lý lịch, chế độ PM,&#xa;SOP/DAS, linh kiện…" vertex="1">
          <mxGeometry height="92" width="210" x="890" y="70" as="geometry" />
        </mxCell>
