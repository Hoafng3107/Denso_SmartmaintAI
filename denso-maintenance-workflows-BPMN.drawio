        <mxCell id="expert-label" parent="expert" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;align=center;fontSize=18;fontStyle=1;fontColor=#267567;" value="CHUYÊN GIA" vertex="1">
