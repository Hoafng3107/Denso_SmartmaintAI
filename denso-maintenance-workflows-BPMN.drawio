        <mxCell id="ai-hint" parent="ai" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;align=center;fontSize=13;fontColor=#64748b;" value="Lưu liên tục&#xa;Hỗ trợ có căn cứ" vertex="1">
