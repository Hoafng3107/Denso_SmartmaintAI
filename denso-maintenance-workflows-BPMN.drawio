        <mxCell id="note-1" parent="expert" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="Ghi nhanh theo mẫu ngắn — phù hợp câu trả lời 1-B: Quan sát / Kiểm tra / Nhận định / Thao tác / Kết quả.&#xa;Nội dung là ô tự do; số đo kèm đơn vị, kết quả và lý do lựa chọn chỉ mở khi liên quan. Có thể ghi bù với thời điểm thực tế.&#xa;PM: ghi từng hạng mục đạt/không đạt/chưa thực hiện, số đo và bất thường; không tự đánh dấu hoàn tất từ kế hoạch.&#xa;AI chỉ gợi ý bổ sung khi thiếu căn cứ ở mốc quan trọng; không tự biến giả thuyết thành nguyên nhân gốc hoặc loại trừ nguyên nhân.&#xa;Nhật ký tự lưu cả khi chưa khắc phục. Nháp báo cáo dùng cùng reportId, chỉ đổi revision; xem trước không kết thúc đợt." vertex="1">
          <mxGeometry height="235" width="1450" x="5070" y="45" as="geometry" />
        </mxCell>
        <mxCell id="r-join" parent="expert" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#172b43;rounded=1;arcSize=12;fillColor=#eaf7f5;strokeColor=#267567;strokeWidth=1.6;spacing=10;" value="Nhận hỗ trợ; ghi lúc&#xa;bắt đầu tham gia, công đoạn&#xa;và vai trò của chuyên gia" vertex="1">
          <mxGeometry height="92" width="210" x="1430" y="65" as="geometry" />
        </mxCell>
        <mxCell id="r-investigate" parent="expert" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#172b43;rounded=1;arcSize=12;fillColor=#eaf7f5;strokeColor=#267567;strokeWidth=1.6;spacing=10;" value="Điều tra / giải thích&#xa;Giả thuyết, bằng chứng&#xa;và lý do đổi hướng" vertex="1">
