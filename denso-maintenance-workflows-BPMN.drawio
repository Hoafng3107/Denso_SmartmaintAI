        <mxCell id="reviewer-label" value="CHUYÊN GIA&#xa;TRƯỞNG" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;align=center;fontSize=18;fontStyle=1;fontColor=#a67426;" parent="reviewer" vertex="1">
          <mxGeometry x="10" y="20" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="reviewer-hint" value="Duyệt tri thức&#xa;đúng phạm vi" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;align=center;fontSize=13;fontColor=#64748b;" parent="reviewer" vertex="1">
          <mxGeometry x="15" y="130" width="150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="Tự động lưu nháp khi nhập và chỉnh sửa.&#xa;Một nội dung họp có thể tạo nhiều đề xuất;&#xa;chuyên gia kiểm tra từng đề xuất.&#xa;Voice-to-text: hướng phát triển sau MVP." style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" parent="expert" vertex="1">
          <mxGeometry x="320" y="6" width="530" height="102" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="AI không tự điền dữ kiện chưa có. Mục bắt buộc phải được xác nhận;&#xa;&quot;không áp dụng / chưa xác định&quot; cần lý do theo quy định biểu mẫu.&#xa;Đối chiếu gồm triệu chứng, nguyên nhân, điều kiện áp dụng,&#xa;giới hạn và bước an toàn; không chỉ đếm từ khóa trùng." style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" parent="ai" vertex="1">
          <mxGeometry x="600" y="286" width="650" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="Người duyệt có quyền theo loại máy / chuyên môn.&#xa;Không tự duyệt nội dung mình là tác giả hoặc&#xa;cùng xây dựng; chuyển người duyệt phù hợp.&#xa;Sửa biên tập: lưu dấu vết. Sửa nội dung chuyên môn:&#xa;trả tác giả xác nhận trước khi phê duyệt." style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" parent="reviewer" vertex="1">
          <mxGeometry x="2310" y="75" width="480" height="145" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="Bản nháp ≠ bản chờ duyệt ≠ bản đã duyệt.&#xa;Ghi tác giả, người đóng góp, người duyệt.&#xa;Cập nhật tạo phiên bản mới;&#xa;không ghi đè phiên bản trước.&#xa;Mọi kết quả đều thông báo cho tác giả." style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" parent="reviewer" vertex="1">
          <mxGeometry x="3800" y="50" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="Biểu mẫu bổ sung: model MÁY và model SẢN PHẨM là hai trường riêng; chế độ/tốc độ vận hành, line, ca, điều kiện môi trường.&#xa;Ghi dấu hiệu quan sát được, giả thuyết, căn cứ kiểm tra, lý do đổi hướng, biện pháp và kết quả thực tế.&#xa;Điểm thay đổi 5M1E: Con người / Máy / Vật liệu-sản phẩm / Phương pháp / Đo lường / Môi trường.&#xa;Mỗi nhóm: Có thay đổi / Chưa ghi nhận / Chưa kiểm tra. Không ép điền mọi nhóm khi không liên quan.&#xa;HozenDX cung cấp ngữ cảnh và hồ sơ tham chiếu; dữ liệu thô không tự trở thành know-how đã duyệt." style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" parent="reviewer" vertex="1">
          <mxGeometry x="300" y="60" width="1250" height="145" as="geometry" />
        </mxCell>
