        <mxCell id="expert-hint" parent="expert" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;align=center;fontSize=13;fontColor=#64748b;" value="Điều tra / xử lý&#xa;Xác nhận đóng góp" vertex="1">
