        <mxCell id="note-2" parent="reviewer" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="Người duyệt có quyền theo loại máy / chuyên môn.&#xa;Không tự duyệt nội dung mình là tác giả hoặc&#xa;cùng xây dựng; chuyển người duyệt phù hợp.&#xa;Sửa biên tập: lưu dấu vết. Sửa nội dung chuyên môn:&#xa;trả tác giả xác nhận trước khi phê duyệt." vertex="1">
          <mxGeometry height="145" width="480" x="2310" y="75" as="geometry" />
        </mxCell>
        <mxCell id="note-3" parent="reviewer" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="Bản nháp ≠ bản chờ duyệt ≠ bản đã duyệt.&#xa;Ghi tác giả, người đóng góp, người duyệt.&#xa;Cập nhật tạo phiên bản mới;&#xa;không ghi đè phiên bản trước.&#xa;Mọi kết quả đều thông báo cho tác giả." vertex="1">
