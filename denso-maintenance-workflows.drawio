        <mxCell id="expert-hint" parent="expert" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;align=center;fontSize=13;fontColor=#64748b;" value="Tham gia khi&#xa;được yêu cầu" vertex="1">
          <mxGeometry height="110" width="150" x="15" y="130" as="geometry" />
        </mxCell>
        <mxCell id="note-2" parent="expert" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="Báo cáo lưu: người phụ trách ca, từng người tham gia, thời điểm / công đoạn, thao tác và kết quả.&#xa;Chuyên gia xác nhận phần mình đóng góp; người bảo trì xác nhận báo cáo thực tế của ca.&#xa;Nguyên nhân chưa xác định phải ghi rõ; không biến giả thuyết của AI thành kết luận.&#xa;Việc phát sinh sau này được ghi thành việc theo dõi; không coi đề xuất là đã thực hiện.&#xa;Xác nhận báo cáo thực tế không thay thế bước duyệt tri thức tái sử dụng." vertex="1">
          <mxGeometry height="145" width="900" x="3330" y="40" as="geometry" />
        </mxCell>
        <mxCell id="r-join" parent="expert" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#172b43;rounded=1;arcSize=12;fillColor=#eaf7f5;strokeColor=#267567;strokeWidth=1.6;spacing=10;" value="Nhận ca; ghi thời điểm,&#xa;công đoạn tham gia&#xa;và vai trò chuyên gia" vertex="1">
          <mxGeometry height="92" width="210" x="2610" y="60" as="geometry" />
        </mxCell>
        <mxCell id="r-investigate" parent="expert" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#172b43;rounded=1;arcSize=12;fillColor=#eaf7f5;strokeColor=#267567;strokeWidth=1.6;spacing=10;" value="Điều tra theo quy trình&#xa;Ghi nhận định, hướng dẫn,&#xa;việc đã làm và kết quả" vertex="1">
