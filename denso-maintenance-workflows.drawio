        <mxCell id="note-1" parent="reviewer" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="Thông tin AI cung cấp: ưu tiên xử lý trước mắt; đề xuất trung hạn / dài hạn chỉ khi có nguồn và căn cứ.&#xa;Hiển thị nguồn, điều kiện phù hợp, điểm khác, thông tin chưa rõ và cảnh báo của quy trình đã duyệt.&#xa;Có thể hiển thị 1–3 kết quả phù hợp trước, cho mở rộng; không giới hạn cứng nguồn được đối chiếu.&#xa;Không dùng tỷ lệ tương đồng làm xác suất sửa thành công hoặc mức bảo đảm an toàn.&#xa;Thiếu căn cứ / vượt thẩm quyền: cảnh báo và chuyển chuyên gia; chuyên gia vẫn có thể bàn giao ca chưa xử lý." vertex="1">
          <mxGeometry height="150" width="1150" x="320" y="55" as="geometry" />
        </mxCell>
        <mxCell id="note-3" parent="reviewer" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="Mọi ca đều có lịch sử, kể cả ca định kỳ, ca lặp lại, ca chưa xử lý và đề xuất bị từ chối.&#xa;Bổ sung ở vòng kiểm duyệt là sửa đề xuất tri thức; sửa báo cáo thực tế phải có dấu vết và phiên bản.&#xa;Người duyệt khác người tạo / cùng xây dựng đề xuất, được phân công theo loại máy và chuyên môn.&#xa;Nếu nội dung đã có: liên kết sự kiện mới với bản gốc, không tạo case tri thức trùng lặp.&#xa;Nếu có khác biệt có giá trị: đề xuất phiên bản mới hoặc case mới, không ghi đè tự động." vertex="1">
          <mxGeometry height="140" width="1160" x="4650" y="55" as="geometry" />
        </mxCell>
        <mxCell id="r-review" parent="reviewer" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#172b43;rounded=1;arcSize=12;fillColor=#fff5e6;strokeColor=#a67426;strokeWidth=1.6;spacing=10;" value="Người duyệt độc lập&#xa;Đánh giá bằng chứng,&#xa;an toàn và giá trị tái dùng" vertex="1">
          <mxGeometry height="92" width="210" x="6290" y="65" as="geometry" />
        </mxCell>
