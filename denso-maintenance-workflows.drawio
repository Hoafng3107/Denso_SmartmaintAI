        <mxCell id="note-4" parent="ai" style="shape=note;whiteSpace=wrap;html=0;size=12;fillColor=#fffde9;strokeColor=#d4c77b;fontFamily=Arial;fontSize=14;align=left;spacing=12;" value="MVP dùng danh mục máy và kho tri thức mô phỏng; không giả định có kết nối sẵn với HozenDX.&#xa;Tích hợp HozenDX là điểm mở: lấy lý lịch máy và đồng bộ lịch sử ca khi có API / quyền truy cập.&#xa;Kho dùng cho RAG chỉ gồm phiên bản đã phê duyệt; nháp, chờ duyệt, bị từ chối không là hướng dẫn.&#xa;Lịch sử vận hành và kho tri thức tái sử dụng được quản lý riêng, liên kết bằng ID." vertex="1">
          <mxGeometry height="120" width="1030" x="2780" y="270" as="geometry" />
