        <mxCell id="v83" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="432" width="540" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v84" value="UI-14 · Trạng thái xuất bản" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v85" value="Hiện hai thông tin: kết quả kiểm duyệt và khả năng tra cứu.&#xa;Đã duyệt nhưng chưa xong: “Đã duyệt — đang cập nhật tra cứu”.&#xa;Sẵn sàng: “Đã xuất bản”; mở ID/phiên bản chính thức.&#xa;Lỗi cập nhật: “Đã duyệt, chưa sẵn sàng tra cứu”; không hiển thị&#xa;thành công giả.&#xa;Với liên kết case: “Đã duyệt liên kết”; không tạo thêm bản tri&#xa;thức trùng." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="481" width="510" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v86" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="1981" width="540" height="256" as="geometry" />
        </mxCell>
        <mxCell id="v87" value="UI-15 · Thông báo và kết quả" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="1991" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v88" value="Danh sách thông báo: loại sự kiện, mã đối tượng, tiêu đề, người&#xa;xử lý, thời gian, đã đọc/chưa đọc.&#xa;Bấm thông báo mở trạng thái hiện tại, đồng thời giữ sự kiện cũ&#xa;trong timeline.&#xa;Từ chối: hiện lý do, bản bị từ chối, người quyết định; lịch sử ca&#xa;vẫn tồn tại.&#xa;Đã xuất bản: hiện tác giả/người đóng góp/người duyệt và nguồn; có&#xa;thể mở bản chính thức.&#xa;Không gửi email/Slack hoặc thông báo ngoài ứng dụng trong&#xa;prototype." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="2030" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v89" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: k-publish, k-end, k-reject-notify, k-rejected, r-publish, r-published, r-rejected  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="3185" width="2220" height="30" as="geometry" />
        </mxCell>
      </root>
