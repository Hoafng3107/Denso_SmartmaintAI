        <mxCell id="v104" value="SQ15.37 Mở đúng đối tượng và&#xa;hiển thị trạng thái thực tế" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="132" y="3972" width="261" height="38" as="geometry" />
        </mxCell>
        <mxCell id="v105" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="520" width="540" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v106" value="UI-30 · Trạng thái lưu và rời màn hình" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="530" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v107" value="Nhãn rõ: Chưa lưu / Đang lưu / Đã lưu lúc… / Chưa lưu được.&#xa;Lỗi: “Chưa lưu được thay đổi. Giữ màn hình và thử lại.”&#xa;Nút “Thử lưu lại”; giữ nguyên nội dung đang nhập.&#xa;Rời màn hình khi chưa lưu: “Lưu rồi rời”, “Ở lại”, “Rời và bỏ&#xa;thay đổi” có xác nhận.&#xa;Nếu có lưu tạm cục bộ, chỉ ghi “Đã giữ tạm trên thiết bị”; không&#xa;gọi là đã lưu lên hệ thống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="569" width="510" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v108" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="1307" width="540" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v109" value="UI-31 · Khôi phục phiên" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1317" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v110" value="Hiện “Phiên làm việc đã hết hạn. Đăng nhập lại để tiếp tục.”&#xa;Giữ dữ liệu chưa gửi trong ngữ cảnh tài khoản hiện tại; không tự&#xa;bỏ biểu mẫu.&#xa;Sau đăng nhập cùng tài khoản: trở về đúng đối tượng, kiểm tra&#xa;quyền và phiên bản trước khi lưu.&#xa;Đăng nhập bằng tài khoản khác: không tự gửi dữ liệu nháp của tài&#xa;khoản trước." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1356" width="510" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v111" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="1925" width="540" height="176" as="geometry" />
        </mxCell>
        <mxCell id="v112" value="UI-32 · Xung đột phiên bản" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1935" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v113" value="Hiện “Nội dung đã được cập nhật ở phiên khác”.&#xa;Cho xem bản trên hệ thống và thay đổi chưa lưu của mình.&#xa;Nút “Tải bản mới”, “Giữ nội dung để đối chiếu”, “Áp dụng lại phần&#xa;đã chọn”.&#xa;Không có nút ghi đè im lặng; sau gộp phải kiểm tra/đối chiếu lại&#xa;khi cần." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1974" width="510" height="116" as="geometry" />
        </mxCell>
        <mxCell id="v114" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="2661" width="540" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v115" value="UI-33 · Trạng thái AI" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="2671" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v116" value="Đang xử lý: có mô tả tác vụ; không báo kết quả khi chưa có.&#xa;Lỗi: “Chưa nhận được kết quả AI. Dữ liệu đã nhập vẫn được giữ.”&#xa;Có thể thử lại, tự sửa biểu mẫu, đọc nguồn còn hợp lệ hoặc yêu&#xa;cầu chuyên gia tùy tác vụ.&#xa;Kết quả đến muộn trên dữ liệu cũ: “Kết quả dựa trên bản trước”;&#xa;chọn chạy lại hoặc chỉ xem tham khảo.&#xa;Không tự chèn đè lên nội dung người dùng vừa sửa." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="2710" width="510" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v117" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="3575" width="540" height="176" as="geometry" />
        </mxCell>
        <mxCell id="v118" value="UI-34 · Chống tạo trùng do thao tác" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="3585" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v119" value="Khi tạo ca/gửi đề xuất/ra quyết định: khóa nút trong lần gửi.&#xa;Nếu mất phản hồi: cho “Kiểm tra kết quả” hoặc thử lại cùng thao&#xa;tác.&#xa;Máy chủ dùng mã lần thao tác để trả cùng kết quả; không tạo thêm&#xa;ca, đề xuất, quyết định hoặc phiên bản.&#xa;Chỉ hiển thị toast thành công khi biết kết quả đã được ghi." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="3624" width="510" height="116" as="geometry" />
        </mxCell>
        <mxCell id="v120" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: Luồng hỗ trợ prototype  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="4173" width="1935" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
