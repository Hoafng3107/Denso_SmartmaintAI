        <mxCell id="v77" value="SQ08.22 Chọn Thực hiện bảo trì&#xa;định kỳ" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="132" y="2679" width="261" height="38" as="geometry" />
