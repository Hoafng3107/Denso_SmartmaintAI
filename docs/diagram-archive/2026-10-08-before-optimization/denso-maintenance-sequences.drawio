        </mxCell>
        <mxCell id="v108" parent="1" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" value="UI-04 · AI đang xử lý / bản gợi ý" vertex="1">
          <mxGeometry height="32" width="510" x="1440" y="1521" as="geometry" />
        </mxCell>
        <mxCell id="v109" parent="1" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" value="Hiện “Đang sắp xếp nội dung…”; vẫn giữ nội dung gốc.&#xa;Kết quả có liên kết về đoạn nguồn và ô chưa đủ dữ kiện.&#xa;Nếu có nhiều chủ đề: hiện danh sách đề xuất để chọn; mỗi đề xuất&#xa;có nháp riêng.&#xa;Nút: “Dùng bản gợi ý”, “Giữ bản đang sửa”, “Thử lại”, “Tự hoàn&#xa;thiện biểu mẫu”." vertex="1">
          <mxGeometry height="116" width="510" x="1440" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="v110" parent="1" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" value="" vertex="1">
