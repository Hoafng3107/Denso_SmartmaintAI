        </mxCell>
        <mxCell id="v90" value="UI-18 · Kết quả tra cứu cho ca" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v91" value="Đầu trang giữ thẻ máy và tóm tắt dấu hiệu; hiển thị thời điểm và&#xa;lần tra cứu.&#xa;Phía trên: các case và tri thức chuyên gia liên quan, ưu tiên 1–3&#xa;kết quả, có “Xem thêm”.&#xa;Mỗi thẻ có nguồn/phiên bản, điểm phù hợp, khác biệt, điều kiện áp&#xa;dụng, kết quả trước đây.&#xa;Không gọi số tiêu chí trùng là xác suất thành công.&#xa;Đang tải: “Đang tìm tri thức liên quan…”; không thay nhầm kết quả&#xa;của ca khác." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="481" width="510" height="176" as="geometry" />
        </mxCell>
        <mxCell id="v92" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="2180" width="540" height="236" as="geometry" />
        </mxCell>
        <mxCell id="v93" value="UI-19 · Phân tích hỗ trợ quyết định" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="2190" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v94" value="Tóm tắt: đã biết gì, còn thiếu gì, giả thuyết và bằng chứng, các&#xa;bước đã thử.&#xa;Nhóm: xử lý trước mắt / theo dõi-sửa trung hạn / cải tiến-thay&#xa;thế dài hạn; chỉ hiện đề xuất có căn cứ.&#xa;An toàn: trích quy trình phù hợp máy và thao tác; thiếu quy trình&#xa;thì nói rõ cần xác minh.&#xa;Nút “Mở nguồn”, “Bổ sung kiểm tra”, “Chọn phương án”, “Yêu cầu&#xa;chuyên gia”.&#xa;“Chọn phương án” không mang nghĩa AI cho phép vận hành máy." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="2229" width="510" height="176" as="geometry" />
        </mxCell>
        <mxCell id="v95" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-retrieve, r-insight, r-assess, r-route, r-measure  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="3536" width="2220" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
