        <mxCell id="v66" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="432" width="540" height="176" as="geometry" />
        </mxCell>
        <mxCell id="v67" value="UI-08 · Xác nhận gửi đề xuất" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v68" value="Hiện tiêu đề, loại đề xuất, máy/phạm vi, tác giả/người đóng góp,&#xa;kết quả đối chiếu, nguồn hoặc báo cáo ca.&#xa;Cập nhật: hiện ID và phiên bản gốc. Liên kết case: hiện ca và tri&#xa;thức đích.&#xa;Xác nhận “Tôi đã kiểm tra nội dung và phạm vi áp dụng”.&#xa;Nút “Gửi kiểm duyệt”; khi gửi hiện tiến trình và khóa gửi lặp." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="481" width="510" height="116" as="geometry" />
        </mxCell>
        <mxCell id="v69" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="2129" width="540" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v70" value="UI-09 · Đề xuất của tôi" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="2139" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v71" value="Mỗi dòng: mã, tiêu đề, nguồn Chuyên gia/Case, loại Mới/Cập&#xa;nhật/Liên kết, trạng thái, người duyệt, lần cập nhật.&#xa;Chi tiết có timeline: nháp → gửi → phản hồi → gửi lại → quyết&#xa;định.&#xa;Chờ duyệt: xem bản đã gửi, chưa sửa trực tiếp ảnh chụp đó.&#xa;Chưa có người duyệt phù hợp: “Đã gửi — chờ phân công người&#xa;duyệt”; giữ trong hàng đợi đúng chuyên môn." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="2178" width="510" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v72" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: k-submit, k-queue, r-submit  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="2788" width="1935" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
