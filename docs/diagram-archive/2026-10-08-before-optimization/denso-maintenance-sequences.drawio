        </mxCell>
        <mxCell id="v111" parent="1" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" value="UI-05 · Biểu mẫu tri thức" vertex="1">
          <mxGeometry height="32" width="510" x="1440" y="3118" as="geometry" />
        </mxCell>
        <mxCell id="v112" parent="1" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" value="Trường: tiêu đề; loại máy/cụm máy; dấu hiệu/bối cảnh; nguyên nhân&#xa;hoặc nhận định; bước kiểm tra/xử lý; kết quả hoặc bài học; điều&#xa;kiện áp dụng; giới hạn; an toàn; người đóng góp.&#xa;Cho phân biệt “đã xác minh” với “giả thuyết/chưa xác định”.&#xa;Mục không áp dụng/chưa xác định phải có lý do; thiếu nội dung bắt&#xa;buộc thì chưa gửi.&#xa;Nút: “Đối chiếu kho tri thức”, “Quay lại nội dung gốc”, “Lưu và&#xa;thoát”." vertex="1">
          <mxGeometry height="156" width="510" x="1440" y="3157" as="geometry" />
