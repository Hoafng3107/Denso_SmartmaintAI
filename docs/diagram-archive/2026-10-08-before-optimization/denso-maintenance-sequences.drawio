        <mxCell id="v106" parent="1" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" value="Một textbox: “Nhập hoặc dán kinh nghiệm, ghi chú, nội dung cuộc&#xa;họp…”.&#xa;Hiện tác giả từ tài khoản, thời điểm sửa, trạng thái lưu.&#xa;Thông tin ngữ cảnh: loại máy/cụm máy, chủ đề (nếu đã biết).&#xa;Nút: “AI sắp xếp nội dung”, “Lưu và thoát”, “Mở nháp”.&#xa;Không có import file hoặc ghi âm trong MVP." vertex="1">
          <mxGeometry height="116" width="510" x="1440" y="481" as="geometry" />
        </mxCell>
        <mxCell id="v107" parent="1" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" value="" vertex="1">
