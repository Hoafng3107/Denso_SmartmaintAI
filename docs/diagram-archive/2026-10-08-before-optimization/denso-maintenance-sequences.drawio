        <mxCell id="v104" value="" style="edgeStyle=none;html=0;rounded=0;endArrow=open;endFill=0;dashed=1;strokeColor=#526579;strokeWidth=1.4;fontFamily=Arial;fontSize=15;" edge="1" parent="1" source="SQ12.38-s" target="SQ12.38-t">
