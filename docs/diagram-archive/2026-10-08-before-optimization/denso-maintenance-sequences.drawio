        <mxCell id="v80" value="ref SQ04 · Gửi đề xuất mới để kiểm duyệt" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ04">
          <mxGeometry x="45" y="3021" width="1610" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v81" value="Nếu sửa đáng kể nội dung sau khi đối chiếu, hiển thị “Nội dung đã thay đổi — cần đối chiếu lại”. Kết quả trên revision cũ không được dùng để xác nhận bản mới." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1">
          <mxGeometry x="45" y="3143" width="1610" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v82" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="432" width="540" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v83" value="UI-06 · Đối chiếu kho" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v84" value="Hiện bản đang viết và nguồn đã duyệt ở hai cột.&#xa;Mỗi nguồn: ID/phiên bản, tên, máy/phạm vi, tác giả, người duyệt,&#xa;ngày duyệt.&#xa;Bảng giống/khác: triệu chứng, nguyên nhân, điều kiện áp dụng,&#xa;bước xử lý, an toàn, kết quả.&#xa;Tách rõ không có dữ liệu và có khác biệt; mở toàn văn nguồn.&#xa;Không kết luận “trùng” chỉ bằng phần trăm tương đồng." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="481" width="510" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v85" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="1416" width="540" height="216" as="geometry" />
        </mxCell>
        <mxCell id="v86" value="UI-07 · Chọn cách ghi nhận" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="1426" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v87" value="Ba lựa chọn: “Hủy đề xuất trùng”, “Bổ sung bản đã có”, “Tạo tri&#xa;thức mới”.&#xa;Hủy: hộp xác nhận nêu nháp được lưu trữ, bản gốc không đổi; có&#xa;nút “Quay lại”.&#xa;Bổ sung: chọn ID/phiên bản gốc; ghi phần mới, điều kiện khác và&#xa;lý do sửa.&#xa;Tạo mới gần nguồn cũ: giải thích khác biệt; không có kết quả thì&#xa;vẫn cần xác nhận tạo mới." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="1465" width="510" height="156" as="geometry" />
        </mxCell>
        <mxCell id="v88" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: k-compare, k-read, k-classify, k-update, k-new, k-merge, k-archive, k-covered, -SpsiOeKhrRzImmBTtOj-4  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="3308" width="2220" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
