        </mxCell>
        <mxCell id="v64" value="Không tự chọn tác giả làm người duyệt khi thiếu người phù hợp. Gửi lại cùng mã lần gửi chỉ trả kết quả đã có, không tạo hai đề xuất." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1">
          <mxGeometry x="45" y="2537" width="1325" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v65" value="ref SQ05 · Người duyệt mở hồ sơ và quyết định" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ05">
