        <mxCell id="v118" value="Bộ lọc: nguồn đề xuất, máy/phạm vi, loại đề xuất, trạng thái,&#xa;người gửi, thời gian.&#xa;Dòng hồ sơ: mã, tiêu đề, người gửi, số lần bổ sung, người đang&#xa;phụ trách.&#xa;Chi tiết: bản đề xuất; bản gốc nếu cập nhật; so sánh trước/sau;&#xa;nguồn chuyên gia hoặc báo cáo ca; tác giả và mọi người đóng góp.&#xa;Tiêu chí xem xét: bằng chứng, tính đúng, phạm vi, điều kiện áp&#xa;dụng, an toàn, trùng lặp." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="481" width="510" height="156" as="geometry" />
        </mxCell>
        <mxCell id="v119" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="2159" width="540" height="216" as="geometry" />
        </mxCell>
        <mxCell id="v120" value="UI-11 · Hành động kiểm duyệt" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="2169" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v121" value="Nút: “Phê duyệt”, “Yêu cầu bổ sung”, “Từ chối”, “Lưu nhận xét”.&#xa;Cả ba kết quả đều nhập phản hồi; yêu cầu bổ sung chỉ rõ&#xa;trường/đoạn cần sửa.&#xa;Sửa chính tả/bố cục: lưu người sửa và trước/sau.&#xa;Sửa nội dung chuyên môn: gửi tác giả xác nhận qua yêu cầu bổ&#xa;sung.&#xa;Trước khi chốt: hiển thị hành động, phiên bản và hậu quả; cho&#xa;quay lại." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="2208" width="510" height="156" as="geometry" />
        </mxCell>
        <mxCell id="v122" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: k-review, k-decision, k-feedback, k-reject, r-review, r-decision, r-feedback, r-reject  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="4425" width="2220" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
