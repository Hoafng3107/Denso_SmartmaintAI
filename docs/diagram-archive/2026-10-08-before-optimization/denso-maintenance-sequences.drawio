        <mxCell id="v120" value="UI-22 · Phương án và điều kiện an toàn" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v121" value="Hiện hướng đã chọn, nguồn/phiên bản, điều kiện áp dụng, người dự&#xa;kiến làm và giới hạn thẩm quyền.&#xa;Công việc định kỳ dùng quy trình đã phê duyệt của máy; không bắt&#xa;buộc AI chẩn đoán khi không có bất thường.&#xa;Hiện nội dung an toàn tương ứng và người xác nhận điều kiện;&#xa;không chỉ đánh dấu chung “AI đã kiểm tra”.&#xa;Nút “Xác nhận phương án”, “Tiếp tục điều tra”, “Yêu cầu chuyên&#xa;gia”, “Dừng và bàn giao”.&#xa;Thiếu căn cứ/quy trình/phê chuẩn cần thiết: chưa cho ghi nhận bắt&#xa;đầu theo hướng đề xuất." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="481" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v122" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1425" y="2883" width="540" height="216" as="geometry" />
        </mxCell>
        <mxCell id="v123" value="UI-23 · Chưa hoàn tất / bàn giao" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="2893" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v124" value="Chọn “Tiếp tục điều tra”, “Yêu cầu chuyên gia” hoặc “Dừng và bàn&#xa;giao”.&#xa;Bàn giao nhập: lý do dừng, tình trạng máy thực tế, việc đã làm,&#xa;việc còn lại, người/đơn vị nhận theo quyền, lưu ý và thời điểm.&#xa;Thông báo “Đã lưu bàn giao. Ca chưa hoàn tất.”&#xa;Kết thúc phiên không đồng nghĩa sửa xong hoặc máy được phép chạy.&#xa;Mở lại ca dùng cùng caseId và toàn bộ lịch sử, không tạo ca&#xa;trùng." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1440" y="2932" width="510" height="156" as="geometry" />
        </mxCell>
        <mxCell id="v125" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-action-merge, r-plan, r-act, r-verify, r-ok, r-next, r-open-save, r-wait, r-routine  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="4642" width="1935" height="30" as="geometry" />
        </mxCell>
      </root>
