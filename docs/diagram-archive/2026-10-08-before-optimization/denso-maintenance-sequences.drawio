        <mxCell id="v105" value="SQ12.38 Đã lưu báo cáo vào lịch&#xa;sử máy." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="132" y="3766" width="261" height="38" as="geometry" />
        </mxCell>
        <mxCell id="v106" value="ref SQ13 · Đánh giá giá trị tái dùng; không chặn việc lưu lịch sử đã xong" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ13">
          <mxGeometry x="45" y="3834" width="1610" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v107" value="Sau hoàn tất, muốn sửa dữ kiện thực tế phải tạo đính chính có lý do, trước/sau, người sửa và các xác nhận bị ảnh hưởng. Giữ bản cũ. Nếu đã có tri thức xuất bản dựa trên dữ kiện đó, tạo đề xuất cập nhật&#xa;để người duyệt xem lại; không tự thay kho đã duyệt." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1">
          <mxGeometry x="45" y="3956" width="1610" height="68" as="geometry" />
        </mxCell>
        <mxCell id="v108" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="432" width="540" height="256" as="geometry" />
        </mxCell>
        <mxCell id="v109" value="UI-24 · Hoàn thiện báo cáo ca" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v110" value="Điền sẵn từ nhật ký, người bảo trì phải kiểm tra.&#xa;Hiện: máy/ca; thời gian; dấu hiệu ban đầu; nguyên nhân đã xác&#xa;nhận hoặc chưa xác định; hướng đã chọn; thao tác thực tế; kết quả&#xa;và kiểm tra sau xử lý.&#xa;Ghi khác biệt với nguồn/đề xuất AI; bước không áp dụng và lý do;&#xa;việc còn theo dõi trung/dài hạn.&#xa;Danh sách người làm: ai, vai trò, từ công đoạn/thời điểm nào,&#xa;việc làm và trạng thái xác nhận.&#xa;Nút “Lưu báo cáo”, “Gửi xác nhận chuyên gia”, “Hoàn tất ca” theo&#xa;điều kiện." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="481" width="510" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v111" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="1092" width="540" height="216" as="geometry" />
        </mxCell>
        <mxCell id="v112" value="UI-25 · Xác nhận đóng góp chuyên gia" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="1102" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v113" value="Nếu có chuyên gia: người bảo trì gửi xác nhận cho từng người tham&#xa;gia.&#xa;Chuyên gia thấy riêng phần mình và bối cảnh báo cáo, có “Xác nhận&#xa;đúng” / “Yêu cầu sửa” kèm nội dung.&#xa;Hiện trạng thái từng người; chưa đủ xác nhận thì “Báo cáo chờ xác&#xa;nhận”, không báo đã hoàn tất.&#xa;Sửa phần đã xác nhận làm thay đổi ý nghĩa: yêu cầu xác nhận lại&#xa;phần bị ảnh hưởng." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="1141" width="510" height="156" as="geometry" />
        </mxCell>
        <mxCell id="v114" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-report, r-expert-used, r-confirm, r-confirm-merge, r-history  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="4141" width="2220" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
