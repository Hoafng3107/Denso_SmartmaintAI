        <mxCell id="v1" value="DENSO · BIỂU ĐỒ TUẦN TỰ CHO PROTOTYPE" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="2170" height="56" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="15 sequence chi tiết · 3 vai trò người dùng · Thao tác, phản hồi, trạng thái và nhánh ngoại lệ&#xa;Đọc các trang theo thứ tự hoặc bấm vào thẻ để mở tình huống tương ứng." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="2170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Nguồn đã đọc: denso-maintenance-workflows-BPMN.drawio · SHA-256 154786368b23013a…" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="164" width="2170" height="46" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="SQ01 · Đăng nhập và vào đúng không gian làm việc&#xa;&#xa;Cổng chung, tài khoản cá nhân, quyền theo vai trò và phục hồi phiên.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ01">
          <mxGeometry x="40" y="240" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="SQ02 · Nhập tri thức, lưu nháp và AI cấu trúc&#xa;&#xa;Một ô gõ/dán; tự lưu; tách đề xuất từ ghi chú họp; chuyên gia kiểm tra biểu mẫu.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ02">
          <mxGeometry x="780" y="240" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="SQ03 · Đối chiếu tri thức và xử lý nội dung trùng&#xa;&#xa;Đọc giống/khác; hủy đề xuất trùng; tạo mới hoặc bổ sung phiên bản cũ.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ03">
          <mxGeometry x="1520" y="240" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="SQ04 · Xác nhận và gửi đề xuất kiểm duyệt&#xa;&#xa;Dùng chung cho chuyên gia và đề xuất từ ca; kiểm tra lần cuối, ghi chờ duyệt và thông báo.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ04">
          <mxGeometry x="40" y="465" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="SQ05 · Chuyên gia trưởng xem và quyết định kiểm duyệt&#xa;&#xa;Hàng đợi, hồ sơ nguồn, chỉnh biên tập và ba kết quả có phản hồi.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ05">
          <mxGeometry x="780" y="465" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="SQ06 · Người gửi nhận phản hồi và hoàn thiện đề xuất&#xa;&#xa;Sửa theo từng nhận xét; xác nhận phần chuyên gia trưởng đề nghị; đối chiếu lại và gửi lại.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ06">
          <mxGeometry x="1520" y="465" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="SQ07 · Xuất bản tri thức và theo dõi kết quả&#xa;&#xa;Tách đã duyệt khỏi sẵn sàng tra cứu; giữ phiên bản và thông báo mọi kết quả.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ07">
          <mxGeometry x="40" y="690" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v11" value="SQ08 · Mở ca và ghi nhận kiểm tra sơ bộ&#xa;&#xa;Xác định máy, ca mới/đang có, lý lịch, dấu hiệu và nhánh bảo trì định kỳ.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ08">
          <mxGeometry x="780" y="690" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v12" value="SQ09 · RAG tra cứu và hỗ trợ chọn hướng xử lý&#xa;&#xa;Nguồn trước, phân tích sau; phân biệt giống/khác/thiếu dữ kiện; người bảo trì quyết định.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ09">
          <mxGeometry x="1520" y="690" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v13" value="SQ10 · Yêu cầu và ghi nhận chuyên gia tham gia ca&#xa;&#xa;Bàn giao, chờ tiếp nhận, công đoạn tham gia, đóng góp có tên và thời gian.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ10">
          <mxGeometry x="40" y="915" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v14" value="SQ11 · Thực hiện, kiểm tra kết quả và bàn giao ca&#xa;&#xa;Chốt người làm, an toàn, nhật ký, đạt/chưa đạt; ca chờ được tiếp tục đúng ID.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ11">
          <mxGeometry x="780" y="915" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="SQ12 · Báo cáo kết quả và xác nhận đóng góp&#xa;&#xa;Kết quả thực tế, chuyên gia xác nhận phần mình, hoàn tất ca và đính chính có dấu vết.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ12">
          <mxGeometry x="1520" y="915" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="SQ13 · Từ báo cáo ca thành đề xuất tri thức&#xa;&#xa;Giữ mọi lịch sử ca; AI đề xuất liên kết/cập nhật/tạo mới; người bảo trì xác nhận.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ13">
          <mxGeometry x="40" y="1140" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="SQ14 · Mở nguồn tri thức và ghi nhận việc tham khảo&#xa;&#xa;Đọc bản đã duyệt, xem điều kiện, giữ ngữ cảnh ca và phản hồi gắn đúng phiên bản.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ14">
          <mxGeometry x="780" y="1140" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="SQ15 · Ngoại lệ dùng chung và bảo toàn dữ liệu đang nhập&#xa;&#xa;Lỗi lưu, phiên hết hạn, xung đột sửa, AI lỗi/kết quả cũ và chống gửi lặp.&#xa;&#xa;Bấm để mở sequence" style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;align=left;spacing=18;fontFamily=Arial;fontSize=18;fillColor=#eef4fa;strokeColor=#94abc3;" vertex="1" parent="1" link="data:page/SQ15">
          <mxGeometry x="1520" y="1140" width="710" height="199" as="geometry" />
        </mxCell>
        <mxCell id="v19" value="Cách đọc: thời gian từ trên xuống; các cột là đối tượng tham gia. Mũi tên là yêu cầu và phản hồi. alt chọn một nhánh; opt tùy điều kiện; loop lặp; break dừng lần tương&#xa;tác; ref gọi sequence khác." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="1410" width="2160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="v20" value="Đã bám bản BPMN người dùng sửa: nhấn hủy đề xuất trùng; không đủ điều kiện xử lý → chọn tiếp tục điều tra hoặc bàn giao. Ca thực tế luôn được lưu; xuất bản tri thức cần&#xa;duyệt độc lập." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="1496" width="2160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="v21" value="Khung bên phải là đặc tả giao diện: dữ liệu cần hiện, nút bấm, kiểm tra đầu vào và câu thông báo mẫu. Chi tiết về đăng nhập, lỗi lưu, phiên hết hạn và xung đột là đề xuất&#xa;bổ sung cho prototype." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="1582" width="2160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="v22" value="Các lifeline là thành phần logic, không bắt buộc triển khai thành nhiều dịch vụ. Một tài khoản có thể có nhiều quyền được cấp; 3 vai trò chính vẫn được giữ. Thông báo chỉ&#xa;trong web; HozenDX và giọng nói ở hướng mở rộng." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="1668" width="2160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="v23" value="Dùng thêm docs/sequence/prototype-spec.md để đọc đầy đủ từng thông điệp, màn hình và nhánh; docs/sequence/README.md có bảng phân quyền, trạng thái và ánh xạ BPMN." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="1754" width="2160" height="74" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
