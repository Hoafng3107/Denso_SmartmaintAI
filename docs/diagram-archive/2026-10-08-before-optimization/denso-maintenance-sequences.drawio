        <mxCell id="v82" value="SQ07.24 Hiện lý do và lịch sử;&#xa;đề xuất không vào kho RAG; ca&#xa;vẫn được giữ" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1">
