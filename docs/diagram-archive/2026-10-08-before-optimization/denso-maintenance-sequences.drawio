        <mxCell id="v78" value="ref SQ11 · Thực hiện quy trình định kỳ được duyệt, ghi kết quả và kiểm tra hoàn tất" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ11">
          <mxGeometry x="45" y="2747" width="1040" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v79" value="ref SQ11 · Dừng/bàn giao theo quy định, giữ ca chưa hoàn tất" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ11">
          <mxGeometry x="45" y="2904" width="1040" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v80" value="Demo dùng danh mục máy mô phỏng. Hiện nguồn dữ liệu của thẻ máy; không hiển thị “đã đồng bộ HozenDX” nếu chưa có tích hợp. Mọi&#xa;thao tác quan trọng phải gắn đúng caseId." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1">
          <mxGeometry x="45" y="3026" width="1040" height="68" as="geometry" />
        </mxCell>
        <mxCell id="v81" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="432" width="540" height="236" as="geometry" />
        </mxCell>
        <mxCell id="v82" value="UI-16 · Mở ca làm việc" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1155" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v83" value="Nút “Quét mã máy” hoặc ô “Nhập mã máy”; nếu không dùng camera thì&#xa;nhập tay.&#xa;Hiện thẻ máy: mã, tên, loại/model, dây chuyền/khu vực, lịch sử&#xa;gần nhất.&#xa;Chọn loại ca: Sửa chữa do bất thường / Bảo trì, bảo dưỡng định&#xa;kỳ.&#xa;Người phụ trách lấy từ tài khoản; có trường thời điểm phát hiện&#xa;và mô tả ban đầu.&#xa;Cảnh báo nhầm máy: yêu cầu xác nhận thẻ máy trước khi tạo ca." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1155" y="481" width="510" height="176" as="geometry" />
        </mxCell>
        <mxCell id="v84" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="2125" width="540" height="216" as="geometry" />
        </mxCell>
        <mxCell id="v85" value="UI-17 · Ca hiện trường / Kiểm tra sơ bộ" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1155" y="2135" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v86" value="Đầu màn hình luôn có: mã ca, mã máy, khu vực, người phụ trách,&#xa;trạng thái lưu.&#xa;Nhập: dấu hiệu, mã lỗi nếu có, vị trí/cụm máy, số đo kèm đơn vị,&#xa;điều kiện xuất hiện, thay đổi gần đây, đã kiểm tra gì và kết quả.&#xa;Cho ghi “chưa xác định”; không ép nhập nguyên nhân khi chưa biết.&#xa;Nút: “Tra cứu hướng xử lý”, “Thực hiện bảo trì định kỳ”, “Yêu cầu&#xa;chuyên gia”, “Lưu và bàn giao”.&#xa;Hiện cảnh báo an toàn của máy từ quy trình đã duyệt." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1155" y="2174" width="510" height="156" as="geometry" />
        </mxCell>
        <mxCell id="v87" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-start, r-open, r-inspect, r-abnormal  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="3211" width="1650" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
