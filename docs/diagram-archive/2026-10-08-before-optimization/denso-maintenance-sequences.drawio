        <mxCell id="v93" value="SQ10.35 Cập nhật timeline để&#xa;người bảo trì cùng theo dõi" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="417" y="3315" width="261" height="38" as="geometry" />
        </mxCell>
        <mxCell id="v94" value="ref SQ11 · Đánh giá phương án, phối hợp xử lý hoặc chọn điều tra tiếp/bàn giao" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ11">
          <mxGeometry x="45" y="3419" width="1895" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v95" value="Nếu người bảo trì nhập hộ thông tin chuyên gia, lưu riêng người nhập và người thực hiện; để trạng thái chờ chuyên gia xác nhận. Không dùng tài khoản người bảo trì để xác nhận thay chuyên gia." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1">
          <mxGeometry x="45" y="3541" width="1895" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v96" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1995" y="432" width="540" height="176" as="geometry" />
        </mxCell>
        <mxCell id="v97" value="UI-20 · Yêu cầu chuyên gia" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="2010" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v98" value="Nhập lý do, việc cần xác minh và mức khẩn theo quy định nhà máy.&#xa;Hiện tóm tắt: máy, dấu hiệu, dữ kiện, bước đã làm, kết quả, nguồn&#xa;tham khảo, điểm chưa rõ.&#xa;Người bảo trì đọc/sửa tóm tắt trước khi gửi.&#xa;Nút “Gửi yêu cầu”, “Quay lại ca”. Nếu có yêu cầu đang chờ: mở/cập&#xa;nhật yêu cầu đó." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="2010" y="481" width="510" height="116" as="geometry" />
        </mxCell>
        <mxCell id="v99" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1995" y="1667" width="540" height="216" as="geometry" />
        </mxCell>
        <mxCell id="v100" value="UI-21 · Chờ chuyên gia / tiếp nhận" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="2010" y="1677" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v101" value="Người bảo trì thấy trạng thái: đã gửi, đã tiếp nhận, đang tham&#xa;gia; không giả định chuyên gia đã có mặt.&#xa;Chuyên gia thấy máy/khu vực, người gọi, lý do, bản bàn giao và&#xa;timeline.&#xa;Nút chuyên gia: “Nhận hỗ trợ”, “Chưa thể hỗ trợ” kèm lý do.&#xa;Nhận hỗ trợ khác thời điểm bắt đầu tham gia; ghi cả hai khi cần.&#xa;Nếu chưa có người nhận: tiếp tục theo dõi hoặc bàn giao theo quy&#xa;định." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="2010" y="1716" width="510" height="156" as="geometry" />
        </mxCell>
        <mxCell id="v102" value="Nguồn: denso-maintenance-workflows-BPMN.drawio  |  BPMN: r-call, r-handover, r-join, r-investigate  |  Xem 00 · Bản đồ để chọn tình huống." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="28" y="3706" width="2505" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
