        <mxCell id="v103" value="SQ12.37 Đã hoàn tất ca; mở báo&#xa;cáo và bước đề xuất tri thức" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1">
