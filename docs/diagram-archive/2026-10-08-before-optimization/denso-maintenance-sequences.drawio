        <mxCell id="v85" value="SQ13.30 Danh sách mục còn thiếu&#xa;hoặc đủ điều kiện gửi" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1">
