        </mxCell>
        <mxCell id="v86" value="Nếu nội dung đề xuất thay đổi đáng kể so với bản đã đối chiếu, chạy lại khối 1. Cập nhật giữ proposalId; không tạo thêm một đề xuất cho mỗi lần sửa." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1">
          <mxGeometry x="45" y="3061" width="1610" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v87" value="ref SQ04 · Người bảo trì xác nhận và gửi; các loại Liên kết/Cập nhật/Mới đều qua người duyệt" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#edf5f0;strokeColor=#719485;" vertex="1" parent="1" link="data:page/SQ04">
          <mxGeometry x="45" y="3129" width="1610" height="66" as="geometry" />
        </mxCell>
        <mxCell id="v88" value="Nếu AI đối chiếu lỗi: hiện “Lịch sử ca đã được lưu; chưa đối chiếu được tri thức”. Có thể lưu đề xuất đang soạn và thử lại sau; chưa coi đề xuất đã đủ bước gửi." style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=12;fontFamily=Arial;fontSize=15;fillColor=#fffbe8;strokeColor=#d4c77b;" vertex="1" parent="1">
          <mxGeometry x="45" y="3251" width="1610" height="48" as="geometry" />
        </mxCell>
        <mxCell id="v89" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="432" width="540" height="196" as="geometry" />
        </mxCell>
        <mxCell id="v90" value="UI-26 · Giá trị tái sử dụng của ca" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="442" width="510" height="32" as="geometry" />
        </mxCell>
        <mxCell id="v91" value="Hiện xác nhận “Báo cáo đã lưu vào lịch sử máy”.&#xa;Bên trái là dữ kiện thực tế; bên phải là nguồn tương tự và gợi ý&#xa;của AI.&#xa;Bảng đối chiếu: bối cảnh, nguyên nhân, bước xử lý, kết quả, sai&#xa;khác, điều kiện áp dụng và an toàn.&#xa;Ghi rõ phần nào được chứng minh và phần nào còn là nhận định.&#xa;Lỗi AI không làm mất hoặc đổi trạng thái ca đã hoàn tất." style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1725" y="481" width="510" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v92" value="" style="rounded=1;arcSize=6;fillColor=#f7f9fc;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="1143" width="540" height="216" as="geometry" />
