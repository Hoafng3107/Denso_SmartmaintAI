        <mxCell id="v79" value="SQ03.27 Bản đề xuất mới sẵn sàng&#xa;gửi" style="text;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#24364b;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1">
